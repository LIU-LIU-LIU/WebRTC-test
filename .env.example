#配置peerjs server的路径与密钥
PEERJS_PROT=9001
PEERJS_PATH=/peer
PEERJS_KEY=peerJSserver

#如果你有自己的ice服务，取消注释以指定。
#不配置时仅尝试直连；跨公网建议配置 STUN 和 TURN
#STUN_URL=stun:stun.l.google.com:19302
#TURN_URL=turn:you.example.com:3478
#TURN 使用 coturn 的 use-auth-secret 模式，与 turnserver.conf 的 static-auth-secret 保持一致
#后端按请求签发临时账号，密钥不会下发到浏览器
#TURN_SECRET=change-me-to-a-long-random-string
#临时凭据有效期(秒)，需大于一场直播时长，默认 43200
#TURN_TTL=43200
